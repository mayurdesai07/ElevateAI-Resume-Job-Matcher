# =====================================================================
# ElevateAI — Environment Configuration
# =====================================================================
# NOTE: ElevateAI already works 100% out-of-the-box with live conversational
# AI models (via our zero-key fallback engine) even if no keys are provided!
#
# If you want to connect your own custom models, simply paste your key below:
# =====================================================================

# 1. Google Gemini API Key (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 2. OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# 3. Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=
